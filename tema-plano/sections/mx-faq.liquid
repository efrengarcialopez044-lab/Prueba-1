{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
  }
  #shopify-section-{{ section.id }} .mx-titulo { font-size: {{ section.settings.titulo_tamano }}px; }
  @media (max-width: 749px) { #shopify-section-{{ section.id }} .mx-titulo { font-size: {{ section.settings.titulo_tamano | times: 0.66 | round }}px; } }
{% endstyle %}

<section class="mx-section mx-faq"{% if section.settings.ancla != blank %} id="{{ section.settings.ancla }}"{% endif %}>
  <div class="mx-contenedor mx-contenedor--estrecho">
    <div class="mx-centro mx-aparece">
      {%- if section.settings.titulo != blank -%}<h2 class="mx-titulo">{{ section.settings.titulo }}</h2>{%- endif -%}
      {%- if section.settings.texto != blank -%}<div class="mx-sub">{{ section.settings.texto }}</div>{%- endif -%}
    </div>
    <div class="mx-faq__lista mx-aparece">
      {%- for block in section.blocks -%}
        <details{% if forloop.first and section.settings.primera_abierta %} open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.pregunta }}</summary>
          <div class="mx-faq__respuesta">{{ block.settings.respuesta }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plano – Preguntas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Preguntas frecuentes." },
    { "type": "richtext", "id": "texto", "label": "Texto" },
    { "type": "text", "id": "ancla", "label": "Nombre del ancla (para enlazar con /#nombre)", "default": "preguntas" },
    { "type": "checkbox", "id": "primera_abierta", "label": "Primera pregunta abierta", "default": false },
    { "type": "range", "id": "titulo_tamano", "label": "Tamaño del título", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 }
    ,
    { "type": "header", "content": "Fondo y espaciado" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo de la sección", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    { "type": "pregunta", "name": "Pregunta", "settings": [
      { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Cómo lo recibo?" },
      { "type": "richtext", "id": "respuesta", "label": "Respuesta", "default": "<p>Al momento, en tu email.</p>" }
    ] }
  ],
  "presets": [ { "name": "Plano – Preguntas", "blocks": [ { "type": "pregunta" } ] } ]
}
{% endschema %}
