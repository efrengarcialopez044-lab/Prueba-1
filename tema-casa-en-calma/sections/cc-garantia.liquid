{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
  }
  #shopify-section-{{ section.id }} .cc-garantia__caja { background: {{ section.settings.color_caja }}; }
{% endstyle %}

<section class="cc-section cc-garantia">
  <div class="cc-contenedor" style="max-width: 1000px">
    <div class="cc-garantia__caja cc-aparece">
      <div class="cc-sello" aria-hidden="true"><strong>{{ section.settings.dias }}</strong><span>días</span></div>
      <div>
        <h2 class="cc-titulo" style="font-size: 38px">{{ section.settings.titulo }}</h2>
        <div class="cc-texto">{{ section.settings.texto }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Casa – Garantía",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "dias", "label": "Días de garantía", "min": 7, "max": 60, "step": 1, "default": 14 },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Garantía de devolución de 14 días" },
    { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Si no te ayuda, te devolvemos el dinero.</p>" },
    { "type": "color", "id": "color_caja", "label": "Color de la caja", "default": "#F1EADD" }
    ,
    { "type": "header", "content": "Fondo y espaciado" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo de la sección", "default": "#F6F1E7" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Casa – Garantía" } ]
}
{% endschema %}
