{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.color_fondo }};
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
  }
  #shopify-section-{{ section.id }} .cc-titulo { font-size: {{ section.settings.titulo_tamano }}px; }
  @media (max-width: 749px) { #shopify-section-{{ section.id }} .cc-titulo { font-size: {{ section.settings.titulo_tamano | times: 0.66 | round }}px; } }
{% endstyle %}

{%- liquid
  assign reales = 0
  for block in section.blocks
    unless block.settings.texto contains '['
      assign reales = reales | plus: 1
    endunless
  endfor
-%}
{%- if reales > 0 or request.design_mode or section.settings.mostrar_vacio -%}
<section class="cc-section cc-testimonios" id="resenas">
  <div class="cc-contenedor">
    <div class="cc-cabecera cc-centro cc-aparece">
      {%- if section.settings.antetitulo != blank -%}<p class="cc-ante">{{ section.settings.antetitulo }}</p>{%- endif -%}
      <h2 class="cc-titulo">{{ section.settings.titulo }}</h2>
    </div>
    {%- if reales == 0 and section.settings.mostrar_vacio -%}
      <div class="cc-resenas-vacio cc-aparece">
        <p class="cc-estrellas" aria-hidden="true">★★★★★</p>
        <h3>{{ section.settings.vacio_titulo }}</h3>
        <p>{{ section.settings.vacio_texto }}</p>
        {%- if section.settings.vacio_boton != blank -%}<a class="cc-btn" href="#{{ section.settings.vacio_destino | default: 'comprar' }}">{{ section.settings.vacio_boton }}</a>{%- endif -%}
        {%- if request.design_mode -%}<p class="cc-testimonio__aviso" style="margin-top: 18px">Tus clientas ven este mensaje mientras no haya reseñas reales. Abajo, los huecos para rellenar (solo los ves tú).</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="cc-testimonios__grid">
      {%- for block in section.blocks -%}
        {%- assign hueco = false -%}
        {%- if block.settings.texto contains '[' -%}{%- assign hueco = true -%}{%- endif -%}
        {%- if hueco and request.design_mode == false -%}{%- continue -%}{%- endif -%}
        <figure class="cc-testimonio cc-aparece{% if hueco %} cc-testimonio--hueco{% endif %}" style="--cc-retraso: {{ forloop.index0 | times: 0.1 }}s" data-cc-tilt {{ block.shopify_attributes }}>
          {%- if block.settings.estrellas > 0 -%}
            <p class="cc-estrellas" aria-label="{{ block.settings.estrellas }} de 5 estrellas">{% for i in (1..block.settings.estrellas) %}★{% endfor %}</p>
          {%- endif -%}
          {%- if hueco -%}<p class="cc-testimonio__aviso">RELLENAR con una opinión real · solo lo ves tú en el editor</p>{%- endif -%}
          <blockquote>“{{ block.settings.texto }}”</blockquote>
          <figcaption>
            {%- if block.settings.foto != blank -%}{{ block.settings.foto | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            <span>{{ block.settings.nombre }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Casa – Testimonios",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Usa solo opiniones reales de clientas. Inventarlas es ilegal y puede costarte la tienda." },
    { "type": "text", "id": "antetitulo", "label": "Antetítulo", "default": "Reseñas" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Lo que dicen quienes ya lo han hecho" },
    { "type": "range", "id": "titulo_tamano", "label": "Tamaño del título", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "header", "content": "Mientras no haya reseñas" },
    { "type": "checkbox", "id": "mostrar_vacio", "label": "Mostrar un mensaje de lanzamiento", "default": true },
    { "type": "text", "id": "vacio_titulo", "label": "Título", "default": "Acabamos de lanzar el reto" },
    { "type": "textarea", "id": "vacio_texto", "label": "Texto", "default": "Sé de las primeras en hacerlo y cuéntanos qué tal: tu opinión aparecerá aquí." },
    { "type": "text", "id": "vacio_boton", "label": "Botón – texto", "default": "Quiero ser de las primeras" },
    { "type": "text", "id": "vacio_destino", "label": "Botón – ancla a la que lleva", "default": "comprar" }
    ,
    { "type": "header", "content": "Fondo y espaciado" },
    { "type": "color", "id": "color_fondo", "label": "Color de fondo de la sección", "default": "#FBF5F1" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "testimonio", "name": "Testimonio", "settings": [
      { "type": "textarea", "id": "texto", "label": "Testimonio", "default": "[Testimonio real de una clienta]" },
      { "type": "text", "id": "nombre", "label": "Nombre y ciudad", "default": "[Nombre], [ciudad]" },
      { "type": "image_picker", "id": "foto", "label": "Foto (opcional)" },
      { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 0, "max": 5, "step": 1, "default": 5 }
    ] }
  ],
  "max_blocks": 9,
  "presets": [ { "name": "Casa – Testimonios", "blocks": [ { "type": "testimonio" }, { "type": "testimonio" }, { "type": "testimonio" } ] } ]
}
{% endschema %}
