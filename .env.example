# Sin estas variables, la app funciona en "modo demo" con datos de ejemplo
# en memoria (ver lib/mock-store.ts): la web y el panel de administración
# son completamente navegables y funcionales sin configurar nada.

# --- Supabase ------------------------------------------------------------
# Actívalo aplicando supabase/migrations/0001_init.sql en tu proyecto y
# creando un usuario en Authentication > Users (será el propietario/admin).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: solo en el servidor, nunca la expongas al cliente.
# Se usa para escrituras administrativas (reservas, ajustes) desde las API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Emails (opcional) -----------------------------------------------------
# Sin configurar, los emails se registran en la consola del servidor en
# lugar de enviarse (ver lib/email.ts).
RESEND_API_KEY=
EMAIL_FROM=reservas@casaelody.com

# --- Stripe (opcional, preparado pero no activado) --------------------------
# Ver lib/stripe.ts para cómo activar el cobro de las reservas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Calendar (opcional) --------------------------------------------
# Sincroniza cada reserva confirmada como evento en el calendario del
# propietario. Sin estas variables, se registra en consola en vez de
# sincronizarse (ver lib/google-calendar.ts). Pasos:
#   1. Crea un proyecto en https://console.cloud.google.com y activa la
#      "Google Calendar API".
#   2. Crea una cuenta de servicio (Service Account) y genera una clave JSON.
#   3. En Google Calendar, comparte el calendario del propietario con el
#      email de la cuenta de servicio, con permiso "Realizar cambios en los
#      eventos".
#   4. Copia aquí el email de la cuenta de servicio, su clave privada (tal
#      cual aparece en el JSON, con los "\n") y el ID del calendario
#      compartido (normalmente el email de Gmail del propietario).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# --- Google Analytics (opcional) -------------------------------------------
# Sin esta variable no se carga ningún script de Google Analytics, aunque
# el aviso de cookies siempre se muestra. Se activa solo tras aceptar
# cookies (ver components/CookieConsent.tsx y components/GoogleAnalytics.tsx).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
